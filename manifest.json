{
  "manifest_version": 3,
  "name": "Mobile View Batch Tester",
  "version": "2.6.0",
  "description": "Batch test responsive mobile and desktop views, device viewports (iPhone, Pixel, Laptop), and user-agents in tabs or windows.",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mobile View Batch Tester",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "scripts/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
